APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Origin frontend yang diizinkan CORS (boleh lebih dari satu, pisah koma)
FRONTEND_URL=http://localhost:5173

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Disk foto menu: "public" (lokal/storage:link) atau "s3" (Supabase/R2)
PHOTO_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

REVERB_APP_ID=dinflow-pos
REVERB_APP_KEY=dinflow-pos-key
REVERB_APP_SECRET=dinflow-pos-secret
REVERB_SERVER_ID=reverb
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
REVERB_SERVER_HOSTNAME=127.0.0.1
REVERB_SERVER_DEBUG=true
REVERB_SERVER_SCHEME=http
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
# Origin WebSocket yang diizinkan (pisah koma, default semua)
REVERB_ALLOWED_ORIGINS=*

VITE_APP_NAME="${APP_NAME}"

# Password awal staf baru & hasil reset oleh admin
DINFLOW_DEFAULT_PASSWORD=1234

# =====================================================================
# TEMPLATE PRODUKSI — Skenario B (VPS hemat + layanan gratis)
# ---------------------------------------------------------------------
# Nilai-nilai di blok ini SEMUA DALAM KOMENTAR (#) sehingga TIDAK aktif
# dan TIDAK memengaruhi environment lokal. .env (tanpa "example") yang
# dipakai aplikasi, jadi lokal tetap aman.
#
# Cara pakai saat deploy ke VPS:
#   1. ssh ke VPS → cp .env.example .env
#   2. Hapus tanda "#" pada baris yang mau diaktifkan di bawah
#   3. Isi nilai NYATA (Neon / Upstash / Supabase / DuckDNS / Reverb)
#   4. php artisan key:generate → migrate --force → db:seed → storage:link
#
# Referensi lengkap: docs/deployment.md §1 (langkah 4) + §5A (DuckDNS/SSL).
# =====================================================================

# --- App (production) ---
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://dineflow.duckdns.org
# FRONTEND_URL=https://<nama-proyek>.vercel.app

# --- Database: Neon (PostgreSQL gratis) ---
# DB_CONNECTION=pgsql
# DB_HOST=<neon-host>          # mis. ep-xxx-xxx.us-east-1.aws.neon.tech
# DB_PORT=5432
# DB_DATABASE=dineflow_pos
# DB_USERNAME=dineflow
# DB_PASSWORD=<password-neon>
# Neon butuh SSL: tanpa konfigurasi tambahan Laravel pgsql sudah pakai sslmode=require lewat URL,
# atau set: # DB_SSLMODE=require  (bila diperlukan)

# --- Redis: Upstash (gratis) ---
# REDIS_CLIENT=predis           # perlu karena Upstash via TCP; predis sudah terinstall
# REDIS_URL=rediss://<username>:<password>@<region>.upstash.io:<port>
# CACHE_STORE=redis
# SESSION_DRIVER=redis
# BROADCAST_CONNECTION=reverb
# QUEUE_CONNECTION=sync         # PENTING untuk VPS 1GB: hindari proses queue worker

# --- Reverb (WebSocket) lewat DuckDNS + SSL ---
# REVERB_SERVER_HOST=0.0.0.0
# REVERB_SERVER_PORT=8080
# REVERB_SERVER_HOSTNAME=dineflow.duckdns.org
# REVERB_SERVER_SCHEME=https
# REVERB_SERVER_DEBUG=false
# REVERB_HOST=dineflow.duckdns.org
# REVERB_PORT=443               # lewat Nginx proxy + certbot
# REVERB_SCHEME=https
# REVERB_ALLOWED_ORIGINS=https://<nama-proyek>.vercel.app

# --- Foto menu: Supabase Storage (S3-compatible) ---
# FILESYSTEM_DISK=s3
# PHOTO_DISK=s3
# AWS_ACCESS_KEY_ID=<supabase-service-role-key>
# AWS_SECRET_ACCESS_KEY=<supabase-service-role-key>   # untuk S3 storage pakai service role dari dashboard
# AWS_DEFAULT_REGION=<bucket-region>                  # lihat di Supabase (mis. ap-southeast-1)
# AWS_BUCKET=<supabase-bucket-name>
# AWS_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
# AWS_URL=<public-url-ke-bucket>                       # dari Supabase (jika diset publik)
# AWS_USE_PATH_STYLE_ENDPOINT=true                    # WAJIB true untuk Supabase (bukan AWS asli)

# --- SSE/compat (jika tidak pakai Reverb) ---
# BROADCAST_CONNECTION=log

